
conky.config = {
    alignment = 'top_right',
    background = false,
    border_width = 1,
    cpu_avg_samples = 1,
    net_avg_samples = 1,

    -- Elegant Color Palette
    default_color = 'cccccc',
    color0 = 'ffffff',      -- Pure White for icons
    color1 = 'dddddd',      -- Light Grey for primary text
    color2 = 'ffffff',      -- Pure White for text
    color3 = 'aaaaaa',      -- Mid Grey for secondary text
    color4 = '1793D1',      -- Arch Blue for headers and graphs

    default_outline_color = 'white',
    default_shade_color = 'white',
    double_buffer = true,
    draw_borders = false,
    draw_graph_borders = true,
    draw_outline = false,
    draw_shades = false,
    extra_newline = false,
    font = 'Liberation Sans:size=8',
    gap_x = 25,
    gap_y = 40,
    minimum_height = 5,
    minimum_width = 182,
    maximum_width = 182,
    no_buffers = true,
    out_to_console = false,
    out_to_ncurses = false,
    out_to_stderr = false,
    out_to_x = true,
    own_window = true,
    override_utf8_locale = true,
    format_human_readable = true,
    own_window_class = 'Conky',
    own_window_type = 'desktop',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    show_graph_range = false,
    show_graph_scale = false,
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_argb_value = 200,
    stippled_borders = 0,
    update_interval = 2.0,
    uppercase = false,
    use_spacer = 'none',
    use_xft = true,
}

conky.text = [[
#-- CLOCK --
#${voffset 4}${font Liberation Sans:style=Bold:size=8}DATE $stippled_hr${font}
${voffset -2}${alignc}${color2}${font Liberation Sans:style=Bold:size=30}${time %H:%M}${font}${color}
${alignc}${color1}${time %A, %d %B %Y}${color}

#-- SYSTEM --
${voffset 8}${font Liberation Sans:style=Bold:size=8}${color4}SYSTEM $stippled_hr${font}
${color0}${voffset 8}${offset 4}${font ConkyColorsLogos:size=9}a${font}${color}${voffset -16}
${color0}${font ConkyColors:size=16}b${font}${color}
${goto 32}${voffset -23}${color1}Kernel: ${alignr}${color2}${kernel}${color}
${goto 32}${color1}Uptime: ${alignr}${color2}${uptime}${color}

#-- CPU --
${voffset 8}${font Liberation Sans:bold:size=8}${color4}PROCESSOR $stippled_hr${font}
${voffset 4}${color1}AMD Ryzen 5 PRO 3400G${color}
#${alignc}${color3}AMD Ryzen 5 PRO 3400G  ·  4C / 8T${color}
${color1}Usage: ${color2}${cpu cpu0}% ${alignr}${color1}Freq: ${color2}${freq_g} GHz${color}
${color4}${cpugraph cpu0 20,182 1793D1 FFFFFF}${color}
${voffset 2}${font Liberation Sans:size=8}${color1}Core 1: ${color2}${cpu cpu1}% ${goto 95} ${color1}Core 2: ${color2}${cpu cpu2}%
${color3}${cpubar cpu1 4,87} ${goto 95} ${cpubar cpu2 4,87}
${color1}Core 3: ${color2}${cpu cpu3}% ${goto 95} ${color1}Core 4: ${color2}${cpu cpu4}%
${color3}${cpubar cpu3 4,87} ${goto 95} ${cpubar cpu4 4,87}
${color1}Core 5: ${color2}${cpu cpu5}% ${goto 95} ${color1}Core 6: ${color2}${cpu cpu6}%
${color3}${cpubar cpu5 4,87} ${goto 95} ${cpubar cpu6 4,87}
${color1}Core 7: ${color2}${cpu cpu7}% ${goto 95} ${color1}Core 8: ${color2}${cpu cpu8}%
${color3}${cpubar cpu7 4,87} ${goto 95} ${cpubar cpu8 4,87}${font}
${voffset 2}Load: ${color2}${loadavg 1}${color} (1m) ${color2}${loadavg 2}${color} (5m) ${color2}${loadavg 3}${color} (15m)

#-- MEM --
${voffset 8}${font Liberation Sans:bold:size=8}${color4}MEMORY $stippled_hr${font}
${voffset 4}${font Liberation Sans:size=8}${color1}RAM $alignc ${color2}$mem / $memmax $alignr ${color2}$memperc%
${color4}$membar${color}
##############
# - NVIDIA - #
##############
#~ ${voffset 4}${font Liberation Sans:style=Bold:size=8}NVIDIA $stippled_hr${font}
#~ ${color0}${voffset 2}${font ConkyColorsLogos:size=16}n${font}${color}${goto 32}${voffset -8}GPU Temp:${alignr}${font Liberation Sans:style=Bold:size=8}${color1} ${exec nvidia-settings -q [gpu:0]/GPUCoreTemp | grep Attribute | cut -d ' ' -f 6 | cut -c 1-2}${font}${color}°C

##########
# - HD - #
##########
${voffset 8}${font Liberation Sans:style=Bold:size=8}${color4}STORAGE $stippled_hr${font}
${execpi 60 perl /usr/share/conkycolors/bin/conkyHD2}
#${execpi 60 perl ~/.conkycolors/scripts/conkyHD5.pl}
###############
# - NETWORK - #
###############
${voffset 8}${font Liberation Sans:style=Bold:size=8}${color4}NETWORK $stippled_hr${font}
# |--ETH0
${if_up enp4s0}
${voffset -5}${color0}${font ConkyColors:size=17}v${font}${color}${goto 32}${voffset -5}${color1}Up: ${font Ubuntu:style=Bold:size=8}${color2}${upspeed enp4s0}${color}${font} ${alignr}${color2}${upspeedgraph enp4s0 8,60 1793D1 FFFFFF}${color}
${goto 32}${color1}Total: ${font Ubuntu:style=Bold:size=8}${color2}${totalup enp4s0}${color}${font}
${voffset 2}${color0}${font ConkyColors:size=17}u${font}${color}${goto 32}${voffset -5}${color1}Down: ${font Ubuntu:style=Bold:size=8}${color2}${downspeed enp4s0}${color}${font} ${alignr}${color2}${downspeedgraph enp4s0 8,60 1793D1 FFFFFF}${color}
${goto 32}${color1}Total: ${font Ubuntu:style=Bold:size=8}${color2}${totaldown enp4s0}${color}${font}
${voffset 2}${color0}${font ConkyColors:size=16}j${font}${color}${goto 32}${voffset -4}${color1}Local IP: ${alignr}${color2}${addr enp4s0}${color}
${downspeedgraph enp4s0 25,182 1793D1 FFFFFF}
${upspeedgraph enp4s0 25,182 1793D1 FFFFFF}
${color1}Down: ${color2}${downspeed enp4s0}/s $alignr ${color1}Up: ${color2}${upspeed enp4s0}/s
#${goto 32}Public IP: ${alignr}${color2}${execi 10800 curl ifconfig.me}${color}
# |--PPP0
${else}${if_up ppp0}
${voffset -5}${color0}${font ConkyColors:size=17}v${font}${color}${goto 32}${voffset -5}${color1}Up: ${font Ubuntu:style=Bold:size=8}${color2}${upspeed ppp0}${color}${font} ${alignr}${color2}${upspeedgraph ppp0 8,60 1793D1 FFFFFF}${color}
${goto 32}${color1}Total: ${font Ubuntu:style=Bold:size=8}${color2}${totalup ppp0}${color}${font}
${voffset 2}${color0}${font ConkyColors:size=17}u${font}${color}${goto 32}${voffset -5}${color1}Down: ${font Ubuntu:style=Bold:size=8}${color2}${downspeed ppp0}${color}${font} ${alignr}${color2}${downspeedgraph ppp0 8,60 1793D1 FFFFFF}${color}
${goto 32}${color1}Total: ${font Ubuntu:style=Bold:size=8}${color2}${totaldown ppp0}${color}${font}

${voffset 2}${color0}${font ConkyColors:size=16}j${font}${color}${goto 32}${voffset -4}${color1}Local IP: ${alignr}${color2}${addr ppp0}${color}
${else}${voffset 4}${offset 4}${color0}${font Wingdings:size=20}N${font}${color}${voffset -6}${goto 32}${color3}Network Unavailable${voffset 14}${endif}${endif}
################
# - CALENDAR - #
################
#~ ${voffset -2}${color0}${font ConkyColors:size=15}D${font}${voffset -8}${font Liberation Sans:style=Bold:size=7}${offset -17}${voffset 4}${time %d}${font}${color}${voffset -1}${font Liberation Mono:size=7}${execpi 300 DJS=`date +%_d`; cal -m|sed '2,8!d'| sed '/./!d' | sed 's/^/${goto 42} /'| sed 's/$/ /' | sed 's/^/ /' | sed /" $DJS "/s/" $DJS "/" "'${font Liberation Sans:style=Bold:size=8}${voffset -2}${offset -4}${color1} '"$DJS"'${color}${font Liberation Mono:size=7}'" "/}${voffset -1}
############
# - PROC - #
############
${voffset 8}${color0}${font ConkyColors:size=16}C${font}${color}${goto 32}${voffset -10}${color1}Processes: ${color2}${alignr 13}CPU${alignr}RAM${color}
${voffset 2}${goto 32}${color1}${top name 1}${color}${font Liberation Sans:style=Bold:size=8}${color2} ${goto 126}${top cpu 1}${alignr }${top mem 1}${color}${font}
${voffset -1}${goto 32}${color1}${top name 2}${color}${font Liberation Sans:style=Bold:size=8}${color2} ${goto 126}${top cpu 2}${alignr }${top mem 2}${color}${font}
${voffset -1}${goto 32}${color1}${top name 3}${color}${font Liberation Sans:style=Bold:size=8}${color2} ${goto 126}${top cpu 3}${alignr }${top mem 3}${color}${font}
${voffset -1}${goto 32}${color1}${top name 4}${color}${font Liberation Sans:style=Bold:size=8}${color2} ${goto 126}${top cpu 4}${alignr }${top mem 4}${color}${font}
${voffset -1}${goto 32}${color1}${top name 5}${color}${font Liberation Sans:style=Bold:size=8}${color2} ${goto 126}${top cpu 5}${alignr }${top mem 5}${color}${font}
]]
